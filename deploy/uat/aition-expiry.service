[Unit]
Description=Aition UAT order expiry
After=network.target postgresql.service aition-identity.service
[Service]
User=aition
Group=aition
WorkingDirectory=/srv/aition/current
EnvironmentFile=/etc/aition/web.env
Environment=ORDER_ORIGIN=http://127.0.0.1:3001
ExecStart=/usr/local/bin/node scripts/order-expiry-worker.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/aition/shared
[Install]
WantedBy=multi-user.target
